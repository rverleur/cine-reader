include README.md
include PYPI.md
include pyproject.toml
include pytest.ini
graft python/src
graft python/examples
graft python/tests
include python/README.md
include python/API.md
prune python/src/cine_reader.egg-info
prune python/src/cine_handler.egg-info
prune Matlab
prune c_src
prune docs
prune release
prune sample_data
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store

include setup.py
graft rust/cine-core/src
graft rust/cine-core/include
graft rust/cine-core/tests
include rust/cine-core/Cargo.toml
include Cargo.toml
include Cargo.lock
include .cargo/config.toml
graft scripts
include docs/BUILDING.md
include docs/DEVELOPMENT.md
include docs/VALIDATION.md
include rust/cine-core/README.md
graft binaries

# Wheels select one verified backend; source archives retain all collected targets.
# Exclude local build outputs, which have no validated artifact manifest.
recursive-exclude python/src/cine_reader/libs *
global-exclude *.py[cod]
