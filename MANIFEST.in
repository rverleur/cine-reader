include LICENSE README.md PYPI.md CHANGELOG.md
include pyproject.toml setup.py pytest.ini miss_hit.cfg
include Cargo.toml Cargo.lock .cargo/config.toml
graft python/src
graft python/examples
graft python/tests
include python/README.md python/API.md
graft rust/cine-core/src
graft rust/cine-core/include
graft rust/cine-core/tests
include rust/cine-core/Cargo.toml rust/cine-core/README.md
graft Matlab
graft scripts
graft .githooks
graft .github
include docs/BUILDING.md docs/DEVELOPMENT.md docs/VALIDATION.md docs/RELEASING.md
include sample_data/README.md
graft binaries

# Native artifacts live only in binaries/. Wheels select one matching library.
prune python/src/cine_reader.egg-info
prune python/src/cine_handler.egg-info
prune python/src/cine_reader/libs
prune Matlab/private/lib
prune python/examples/output
prune Matlab/examples/output
recursive-exclude Matlab *.mex*
global-exclude __pycache__ *.py[cod] .DS_Store
